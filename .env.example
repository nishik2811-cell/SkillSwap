# --- Server ---
PORT=4000
WEB_ORIGIN=http://localhost:5173        # production: your Vercel URL (CORS + links in emails)
TRUST_PROXY=1                           # production: number of proxies in front of the API
UPLOAD_DIR=                             # production: a persistent volume path, e.g. /data/uploads
# --- PostgreSQL. Production: the connection string from Neon (it includes ?sslmode=require).
#     Local: a Postgres you run yourself, e.g. postgresql://skillswap@127.0.0.1:5433/skillswap
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# --- Auth (Phase 1) ---
JWT_SECRET=generate-with-openssl-rand-hex-32   # 16+ chars; signs the live-socket token
# --- Email / SMTP (Phase 1; Mailpit in dev) ---
SMTP_HOST=
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM=SkillSwap <no-reply@skillswap.local>
# --- Razorpay: leave blank until you have TEST keys (dashboard.razorpay.com > Settings > API Keys, Test Mode).
#     Blank = payments return 'payments_not_configured'; nothing is ever simulated.
#     Webhook: Settings > Webhooks > add https://<your-public-host>/api/v1/webhooks/razorpay with a secret, events:
#     payment.captured, payment.failed, order.paid, refund.processed, refund.failed. Put that secret below. ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# --- LiveKit (Phase 7). Local dev: .tools/livekit/livekit-server --dev  =>  ws://127.0.0.1:7880, key devkey, secret secret
#     (those dev credentials are public defaults: never use them on a real server; use LiveKit Cloud or your own keys). ---
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Where uploads live. Default: local disk (UPLOAD_DIR). Set db to also keep a durable copy in Postgres (for hosts with an ephemeral disk, e.g. Render free).
# FILE_STORE=db

# --- Sign in with Google (optional). Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application).
#     Authorized redirect URI: <WEB_ORIGIN>/api/v1/auth/google/callback  (e.g. http://localhost:5173/api/v1/auth/google/callback). Blank = no Google button. ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
